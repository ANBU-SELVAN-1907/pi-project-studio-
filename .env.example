# PiClaw API credentials
# Copy this to .env and fill in your values.
# .env is never committed to version control.

# Primary LLM endpoint (OmniRoute / OpenAI-compatible local server)
PICLAW_BASE_URL=http://localhost:20128/v1
PICLAW_API_KEY=your-api-key-here
PICLAW_MODEL=auto/best-chat

# Optional: override with specific providers
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
OMNIROUTE_API_KEY=your-omniroute-key-here
